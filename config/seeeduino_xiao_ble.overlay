#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,pointing = &trackpad;
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* Konfiguration för pekaracceleration */
    &pointer_accel {
        min-factor = <1000>;         /* 1.0x vid långsamma rörelser (inga hoppade pixlar!) */
        max-factor = <3500>;         /* 3.5x vid snabba svep (täcker skärmen snabbt) */
        speed-threshold = <1000>;    /* Hastighet där accelerationen börjar trappas upp */
        speed-max = <6000>;          /* Hastighet där max acceleration (3.5x) nås */
        acceleration-exponent = <2>; /* Kvadratisk kurva (mjuk och naturlig känsla) */
        track-remainders;            /* Sparar bråkdelar för maximal pixelprecision */
    };

    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
        /* Använd accelerationsprocessorn istället för zip_xy_scaler */
        input-processors = <&pointer_accel>;
    };
};
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    
    trackpad: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        rdy-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        
        /* Drivrutinens standardegenskaper */
        scroll;
        natural-scroll-y;
        press-and-hold;
        two-finger-tap;
        bottom-beta = <5>;
    };
};
