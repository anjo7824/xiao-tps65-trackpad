/ {
    chosen {
        zmk,pointing = &trackpad;
    };

    // Skapar en dummy-kscan för att ZMK inte ska krascha på saknat tangentbord
    matrix_kscan: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    
    trackpad: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        rdy-gpios = <&gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    };
};
