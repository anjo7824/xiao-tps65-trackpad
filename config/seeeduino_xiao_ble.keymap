#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Position 0 = D9 button: switch to the next BT profile slot.
            // If that slot has no bond yet, the trackpad advertises for
            // pairing with a new host as soon as you press it.
            bindings = <&bt BT_NXT>;
        };
    };
};
